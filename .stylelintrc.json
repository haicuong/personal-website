{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "layer",
          "apply",
          "config",
          "plugin",
          "theme",
          "utility",
          "custom-variant"
        ]
      }
    ],
    "at-rule-empty-line-before": null,
    "at-rule-prelude-no-invalid": null,
    "import-notation": null,
    "rule-empty-line-before": null
  }
}
